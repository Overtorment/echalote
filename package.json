{
  "type": "module",
  "name": "@hazae41/echalote",
  "version": "0.5.0",
  "author": "Overtorment",
  "license": "MIT",
  "description": "Zero-copy Tor protocol for Bun and TypeScript (Overtorment fork: CDN77 meek, pinned deps, Noble crypto, no WASM)",
  "homepage": "https://github.com/Overtorment/echalote",
  "repository": "github:Overtorment/echalote",
  "engines": {
    "node": ">=24"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "test:unit": "bun test tests/unit",
    "test:unit:node": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "bun test tests/integration",
    "test:integration:node": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration --testTimeout=150000",
    "test:package": "bun tests/package/package-smoke.mjs",
    "postinstall": "node scripts/fix-hazae41-x509.mjs"
  },
  "dependencies": {
    "@hazae41/asn1": "1.3.31",
    "@hazae41/base16": "1.0.18",
    "@hazae41/base64": "1.0.15",
    "@hazae41/binary": "1.3.5",
    "@hazae41/bitset": "1.0.1",
    "@hazae41/bytes": "1.2.11",
    "@hazae41/cadenas": "0.4.2",
    "@hazae41/cascade": "2.2.2",
    "@hazae41/cursor": "1.2.4",
    "@hazae41/ed25519": "2.1.21",
    "@hazae41/future": "1.0.3",
    "@hazae41/mutex": "2.1.0",
    "@hazae41/option": "1.1.4",
    "@hazae41/plume": "3.0.5",
    "@hazae41/sha1": "1.1.14",
    "@hazae41/x25519": "2.2.9",
    "@hazae41/x509": "1.2.10",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0"
  },
  "overrides": {
    "@hazae41/asn1": "1.3.31",
    "@hazae41/base16": "1.0.18",
    "@hazae41/base64": "1.0.15",
    "@hazae41/binary": "1.3.5",
    "@hazae41/cursor": "1.2.4",
    "@hazae41/ed25519": "2.1.21",
    "@hazae41/mutex": "2.1.0",
    "@hazae41/sha1": "1.1.14",
    "@hazae41/x25519": "2.2.9",
    "@hazae41/x509": "1.2.10"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.5.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.4"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "keywords": [
    "tor",
    "onion",
    "protocol",
    "nodejs",
    "bun",
    "meek",
    "stream",
    "http",
    "https",
    "privacy",
    "tls",
    "binary",
    "cryptography",
    "typescript"
  ]
}
